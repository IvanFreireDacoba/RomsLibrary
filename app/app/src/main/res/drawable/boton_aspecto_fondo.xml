<?xml version="1.0" encoding="utf-8"?>
<!-- Botón cuadrado de aspecto (lista/cuadrícula): oscuro con borde verde,
     y relleno verde fósforo con el foco del mando. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#7bffb0" />
            <stroke android:width="2dp" android:color="#ffffff" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#244a2e" />
            <stroke android:width="1dp" android:color="#7bffb0" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1c3a24" />
            <stroke android:width="1dp" android:color="#7bffb0" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
