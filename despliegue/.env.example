# ===== RomsLibrary: copia este fichero a .env y rellénalo =====

# Dominio del servicio (la app y otras librerías se conectan aquí) y
# subdominio para la pantalla de inicio de sesión (Authentik). Los dos tienen
# que apuntar (DNS tipo A) a la IP de este servidor, con los puertos 80 y 443
# abiertos: Caddy pide los certificados HTTPS solo.
ROMSLIBRARY_DOMINIO=romslibrary.example.com
AUTENTICACION_DOMINIO=auth.romslibrary.example.com

# Cómo se llama tu librería (lo ven otras librerías públicas).
ROMSLIBRARY_NOMBRE=Mi RomsLibrary

# true = PÚBLICA (compartes tus juegos y ves los de otras librerías públicas),
# false = PRIVADA (solo los tuyos). Se puede cambiar luego desde el gestor.
ROMSLIBRARY_PUBLICO=true

# Índice de librerías públicas (déjalo así para unirte a la red de sund.es).
ROMSLIBRARY_INDICE_URL=https://sund.es

# Clave de acceso que pondrás en la app. Vacío = se genera sola; la ves (y la
# regeneras) en el gestor web, en "Ajustes del servicio".
ROMSLIBRARY_CLAVE_APP=

# Usuario del gestor web (se crea en el primer arranque). ¡Cambia la
# contraseña después desde Authentik (https://AUTENTICACION_DOMINIO)!
ROMSLIBRARY_ADMIN_USUARIO=ADMIN
ROMSLIBRARY_ADMIN_PASSWORD=admin

# ===== Secretos: genera cada uno con   openssl rand -base64 36   =====
ROMSLIBRARY_SECRETO_PROXY=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=
