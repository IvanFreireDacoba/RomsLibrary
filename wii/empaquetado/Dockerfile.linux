# Para compilar la versión de PC de la app de Wii (solo pruebas).
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config python3 \
    libsdl2-dev libsdl2-ttf-dev libsdl2-image-dev libjansson-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
